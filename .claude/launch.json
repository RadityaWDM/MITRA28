      "runtimeArgs": ["-e", "const fs=require('fs'),p=require('path'),T={'.html':'text/html','.css':'text/css','.js':'text/javascript','.md':'text/markdown'};require('http').createServer((q,r)=>{let f=decodeURIComponent(q.url.split('?')[0]);if(f==='/')f='/index.html';const fp=p.join(process.cwd(),p.normalize(f));if(!fp.startsWith(process.cwd())){r.writeHead(403);return r.end()}fs.readFile(fp,(e,d)=>{r.writeHead(e?404:200,{'content-type':(T[p.extname(fp)]||'application/octet-stream')+'; charset=utf-8'});r.end(e?'not found':d)})}).listen(8765)"],
